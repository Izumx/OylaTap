# Copy to deploy/oracle/.env on the server, set actual values, then chmod 600.
# Keep the deployment secret outside Git.
DOMAIN=oylatap.example.com
EDGE_NETWORK=oylatap_edge
# Generate an independent password from URL-safe letters/digits, _ or -.
# Do not use this literal placeholder or characters requiring URL encoding.
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_URL_SAFE_PASSWORD
