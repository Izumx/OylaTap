# Local development only. Supply private credentials for a deployed environment.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://oylatap:oylatap_local@127.0.0.1:5432/oylatap
PORT=3000
DEMO_MODE=true
DATA_DIR=.local/uploads
# Optional: run Ollama on the same machine for an actual AI script draft.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:14b
# Set true only behind HTTPS. Keep demo off when handling actual pupils' data.
COOKIE_SECURE=false
# Optional: local text-to-speech for generated videos, e.g. Piper. JSON array:
# program, then arguments; {out} is the WAV path and the text arrives on stdin.
# TTS_COMMAND_RU=["piper","--model","/voices/ru_RU-irina-medium.onnx","--output_file","{out}"]
# TTS_COMMAND_KK=["piper","--model","/voices/kk_KZ-issai-high.onnx","--output_file","{out}"]
